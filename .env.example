# ============================================================
# Aetheris — Environment Variables Template
# Copy ke .env dan isi dengan nilai Anda
# ============================================================

# ─── Security (WAJIB diubah) ───
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=ubah-ini-jadi-random-string-minimal-64-karakter

# URL publik (untuk OAuth callback)
# Local: http://127.0.0.1:8000
# Tunnel: https://aetheris.osvpn.id
PUBLIC_URL=http://127.0.0.1:8000

# ─── Google OAuth ───
# Setup: https://console.cloud.google.com/apis/credentials
# Redirect URI: {PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── GitHub OAuth ───
# Setup: https://github.com/settings/developers
# Callback URL: {PUBLIC_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Facebook OAuth (opsional) ───
# Setup: https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ─── Advanced (opsional) ───
# REDIS_URL=redis://redis:6379/0
# INSTANCE_ID=aetheris-1
# PRESETS_FILE=/data/presets.json
# DB_PATH=/data/aetheris.db
# CHAT_RETENTION_DAYS=7